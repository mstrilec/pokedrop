# PokeDrop — production environment for compose.production.yml.
#
# Copy to .env.production on the server, fill in every <…>, then
#   chmod 600 .env.production
# It is never committed. docs/Deployment.md explains each value.

# ─── Public address ──────────────────────────────────────────────────────────
# The Tailscale Funnel URL, no trailing slash. The same origin in all four.
WEB_BASE_URL=https://<host>.<tailnet>.ts.net
AUTH_BASE_URL=https://<host>.<tailnet>.ts.net
CORS_ORIGINS=https://<host>.<tailnet>.ts.net

# ─── Runtime ─────────────────────────────────────────────────────────────────
# production also turns secure cookies on.
NODE_ENV=production
LOG_LEVEL=info
PORT=4000

# Funnel sets X-Forwarded-For from the real connection and Next passes it on
# untouched, so the client is exactly one hop behind the web server.
TRUST_PROXY_HOPS=1

# openssl rand -base64 32 — never the development value.
AUTH_SECRET=<generate>
AUTH_COOKIE_SAME_SITE=lax

# ─── Postgres ────────────────────────────────────────────────────────────────
# The first three initialise the cluster; DATABASE_URL repeats them for Prisma
# and the API. A password made of letters and digits needs no URL escaping.
POSTGRES_USER=pokedrop
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=pokedrop
DATABASE_URL=postgresql://pokedrop:<same-password>@postgres:5432/pokedrop

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# ─── Mail: Gmail SMTP with an app password ───────────────────────────────────
# Without working mail nobody can sign in: every account must verify its email.
# The @ in the address is written %40; the app password has no spaces.
MAIL_SMTP_URL=smtps://<gmail-user>%40gmail.com:<app-password>@smtp.gmail.com:465
MAIL_FROM=PokeDrop <<gmail-user>@gmail.com>

# ─── Card data ───────────────────────────────────────────────────────────────
# No API key: pokemontcg.io's key is paid. The keyless budget is enough.
POKEMONTCG_BASE_URL=https://api.pokemontcg.io/v2
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
CARD_SOURCE_PROVIDER=pokemontcg
POKEMONTCG_DAILY_REQUEST_BUDGET=1000

# No nightly syncs: the catalog and prices are refreshed only when an admin
# presses Run now on /admin/sync.
SYNC_SCHEDULES=false
