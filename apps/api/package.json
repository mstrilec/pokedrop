{
  "name": "@pokedrop/api",
  "version": "0.0.0",
  "private": true,
  "description": "PokeDrop NestJS API. The BullMQ worker shares this codebase via a separate entrypoint.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "dev:worker": "nest start --watch --entryFile worker",
    "db:seed": "node prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "12.0.0",
    "@nestjs/throttler": "6.7.0",
    "@pokedrop/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.5",
    "bullmq": "5.81.5",
    "express": "5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "5.8.2",
    "nestjs-pino": "5.2.0",
    "nodemailer": "10.0.10",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "pino-pretty": "13.1.3",
    "source-map-support": "^0.5.21",
    "typescript": "5.9.3"
  }
}
