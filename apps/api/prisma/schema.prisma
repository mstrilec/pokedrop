generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  COUNTERED
  CANCELLED
  VOIDED
}

enum TradeItemSide {
  OFFERED
  REQUESTED
}

enum PriceSource {
  TCGPLAYER
  CARDMARKET
}

enum TransactionType {
  GRANT
  PACK_SPEND
  TRADE
  TRADE_REVERSAL
}

enum SyncKind {
  CATALOG
  PRICE
  PRICE_ACTIVE
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  displayName   String
  avatarUrl     String?
  role          Role     @default(MEMBER)
  currency      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  showCollectionValue Boolean  @default(false)
  showSetCompletion   Boolean  @default(false)
  showcaseCardIds     String[] @default([])
  suspendedAt         DateTime?

  sessions             Session[]
  accounts             Account[]
  inventoryItems       InventoryItem[]
  packOpenings         PackOpening[]
  currencyTransactions CurrencyTransaction[]
  decks                Deck[]
  tradesInitiated      Trade[]               @relation("TradeInitiator")
  tradesReceived       Trade[]               @relation("TradeRecipient")
  notifications        Notification[]
  auditEntries         AuditLog[]
  activity             UserActivity[]

  @@map("users")
}

model UserActivity {
  userId String
  day    DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
  @@map("user_activity")
}

/// Better Auth core table: change it only by regenerating with the Better Auth CLI.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model CardSet {
  id           String   @id
  name         String
  series       String
  releaseDate  DateTime
  printedTotal Int
  total        Int
  symbolUrl    String?
  logoUrl      String?
  updatedAt    DateTime @updatedAt

  cards Card[]

  @@map("sets")
}

model Card {
  id          String   @id
  setId       String
  name        String
  supertype   String
  subtypes    String[]
  hp          Int?
  types       String[]
  rarity      String?
  retreatCost String[]

  weaknesses  Json
  resistances Json
  attacks     Json
  abilities   Json
  legalities  Json

  nationalPokedexNumbers Int[]
  evolvesFrom            String?

  imageSmall String
  imageLarge String

  tcgplayerId  String?
  cardmarketId String?

  /// Decimal, not Float: summed into collection valuations.
  latestPriceUsd Decimal?  @db.Decimal(10, 2)
  latestPriceEur Decimal?  @db.Decimal(10, 2)
  priceUpdatedAt DateTime?

  updatedAt DateTime @updatedAt

  /// Restrict, not Cascade: cards cascade into InventoryItem, so it would delete user property.
  set CardSet @relation(fields: [setId], references: [id], onDelete: Restrict)

  priceSnapshots     PriceSnapshot[]
  inventoryItems     InventoryItem[]
  packOpeningCards   PackOpeningCard[]
  deckCards          DeckCard[]
  tradeItems         TradeItem[]
  packTemplateCovers PackTemplate[]

  @@index([name])
  @@index([setId])
  @@index([rarity])
  /// GIN, because a btree on an array cannot serve a containment query.
  @@index([types], type: Gin)
  @@index([priceUpdatedAt])
  @@index([evolvesFrom])
  /// The migration adds NULLS LAST, which Prisma cannot express; the price sorts need it.
  @@index([latestPriceUsd(sort: Desc), id(sort: Desc)])
  @@map("cards")
}

model PriceSnapshot {
  id         String      @id @default(cuid())
  cardId     String
  source     PriceSource
  currency   String      @db.VarChar(3)
  market     Decimal?    @db.Decimal(10, 2)
  low        Decimal?    @db.Decimal(10, 2)
  mid        Decimal?    @db.Decimal(10, 2)
  high       Decimal?    @db.Decimal(10, 2)
  capturedAt DateTime

  /// The UTC day of `capturedAt`, so the daily cap is an ordinary unique index. Nothing enforces
  /// that the two agree: the price writer derives both from one instant.
  capturedOn DateTime @db.Date

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, source, capturedOn])
  @@index([cardId, capturedAt])
  @@map("price_snapshots")
}

// CHECK constraints live in hand-written migrations: Prisma has no syntax for them, and neither
// reports them as drift nor drops them.

model InventoryItem {
  id             String   @id @default(cuid())
  userId         String
  cardId         String
  quantity       Int
  lockedQuantity Int      @default(0)
  acquiredAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([userId, cardId])
  @@index([cardId])
  @@map("inventory_items")
}

model PackTemplate {
  id          String  @id @default(cuid())
  name        String
  setFilter   Json
  cost        Int
  slotConfig  Json
  active      Boolean @default(true)
  coverCardId String?
  imageUrl    String?

  coverCard Card?         @relation(fields: [coverCardId], references: [id], onDelete: SetNull)
  openings  PackOpening[]

  @@map("pack_templates")
}

model PackOpening {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  /// The idempotency guard. A retried open with the same id cannot mint twice.
  openId     String   @unique
  seed       String?
  createdAt  DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  template PackTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  cards PackOpeningCard[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("pack_openings")
}

model PackOpeningCard {
  id            String @id @default(cuid())
  packOpeningId String
  cardId        String
  rarity        String
  position      Int

  packOpening PackOpening @relation(fields: [packOpeningId], references: [id], onDelete: Cascade)
  card        Card        @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@index([packOpeningId])
  @@map("pack_opening_cards")
}

/// The ledger behind User.currency; nothing in the schema keeps the two in agreement.
model CurrencyTransaction {
  id        String          @id @default(cuid())
  userId    String
  amount    Int
  type      TransactionType
  refId     String?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Idempotency by unique index, not a read-then-write check, which two concurrent writers
  /// both pass at READ COMMITTED.
  @@unique([userId, type, refId])
  @@index([userId, createdAt])
  @@map("currency_transactions")
}

model Deck {
  id        String   @id @default(cuid())
  userId    String
  name      String
  format    String
  isPublic  Boolean  @default(false)
  ownedOnly Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards DeckCard[]

  @@index([userId])
  @@map("decks")
}

/// No `count <= 4` check: basic Energy is exempt, and this table cannot see the supertype.
model DeckCard {
  id     String @id @default(cuid())
  deckId String
  cardId String
  count  Int

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([deckId, cardId])
  @@index([cardId])
  @@map("deck_cards")
}

model Trade {
  id                    String      @id @default(cuid())
  initiatorId           String
  recipientId           String
  status                TradeStatus @default(PENDING)
  currencyFromInitiator Int         @default(0)
  currencyFromRecipient Int         @default(0)
  createdAt             DateTime    @default(now())
  resolvedAt            DateTime?

  /// Unique: a trade is countered at most once, so a race between two counters is a constraint
  /// violation rather than a fork.
  counteredTradeId String? @unique
  counteredTrade   Trade?  @relation("TradeCounter", fields: [counteredTradeId], references: [id], onDelete: SetNull)
  counterOffer     Trade?  @relation("TradeCounter")

  initiator User @relation("TradeInitiator", fields: [initiatorId], references: [id], onDelete: Restrict)
  recipient User @relation("TradeRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  items TradeItem[]

  @@index([recipientId, status])
  @@index([initiatorId, status])
  @@index([createdAt])
  @@index([resolvedAt, status])
  @@map("trades")
}

model TradeItem {
  id       String        @id @default(cuid())
  tradeId  String
  side     TradeItemSide
  cardId   String
  quantity Int

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  card  Card  @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@index([tradeId])
  @@index([cardId])
  @@map("trade_items")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

/// Append-only by convention. `actorId` null is the system; Restrict, not SetNull, so deleting a
/// user never turns their actions into the system's.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  meta      Json
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt, id])
  @@map("audit_logs")
}

model SyncRun {
  id   String   @id @default(cuid())
  kind SyncKind

  provider String

  status SyncStatus @default(RUNNING)

  /// Resume only when this matches: otherwise a processor would adopt a run abandoned by a killed
  /// process.
  jobId String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  processed Int @default(0)
  failed    Int @default(0)

  cursor Json?
  error  String?

  @@index([kind, startedAt(sort: Desc)])
  @@map("sync_runs")
}
