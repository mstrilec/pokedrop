// PokeDrop database schema.
//
// Note for anyone following docs/Architecture.md: since Prisma 7 the datasource
// block no longer accepts `url`. The connection string for the CLI lives in
// prisma.config.ts, and the client receives a driver adapter at construction.
//
// Tables are mapped to plural snake_case. `user` is a reserved word in
// PostgreSQL — unmapped, the table would be "User" and every hand-written query
// would need the quotes to avoid resolving to CURRENT_USER.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — docs/DataModel.md
//
// All five land here rather than with the models that use them, so that one
// migration creates every enum type and PD-23 onward only add tables.
// `Rarity` is deliberately absent: the list is extensible, so it is a string.
// ---------------------------------------------------------------------------

enum Role {
  MEMBER
  ADMIN
}

enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  COUNTERED
  CANCELLED
  VOIDED
}

enum TradeItemSide {
  OFFERED
  REQUESTED
}

enum PriceSource {
  TCGPLAYER
  CARDMARKET
}

enum TransactionType {
  GRANT
  PACK_SPEND
  TRADE
}

// ---------------------------------------------------------------------------
// Identity
//
// User carries both the Better Auth core fields and our domain fields, because
// the adapter and the application share one client and one table.
//
// Two of the core fields are renamed: Better Auth calls them `name` and
// `image`, and PD-29 must declare that mapping in its `user.fields` block, or
// the adapter will look for columns that do not exist here. `role` and
// `currency` are ours; the adapter only learns about them through
// `user.additionalFields`, and `role` must be declared there with
// `input: false` so no sign-up payload can set it.
//
// There is no passwordHash. Better Auth stores the credential password on
// Account, and a second column here would look like the real one.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  displayName   String
  avatarUrl     String?
  role          Role     @default(MEMBER)
  currency      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions             Session[]
  accounts             Account[]
  inventoryItems       InventoryItem[]
  packOpenings         PackOpening[]
  currencyTransactions CurrencyTransaction[]

  @@map("users")
}

/// Better Auth core table. Fields follow @better-auth/core exactly; do not
/// add or rename without regenerating with the Better Auth CLI.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Better Auth core table. One row per authentication method linked to a user:
/// the credential provider stores its hash in `password`, OAuth providers store
/// their tokens here.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

/// Better Auth core table, used for email verification and password reset
/// tokens. Rows are short-lived.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Catalog mirror
//
// Ids are the provider's own (`base1`, `base1-4`), never generated here, which
// is what makes a re-sync an idempotent upsert rather than a duplicate insert.
//
// `updatedAt` is not in docs/DataModel.md's field list. It is here because the
// sync processor and the admin sync-status endpoint both need to know how stale
// a mirrored row is, and nothing else records that.
// ---------------------------------------------------------------------------

/// docs/DataModel.md calls this `Set`. Named `CardSet` for two reasons: `set`
/// is a reserved word in PostgreSQL, and a generated TypeScript type named
/// `Set` shadows the global one for any file that imports it — the same reason
/// @pokedrop/shared exports `CardSetSchema`.
model CardSet {
  id           String   @id
  name         String
  series       String
  releaseDate  DateTime
  printedTotal Int
  total        Int
  symbolUrl    String?
  logoUrl      String?
  updatedAt    DateTime @updatedAt

  cards Card[]

  @@map("sets")
}

model Card {
  id          String   @id
  setId       String
  name        String
  supertype   String
  subtypes    String[]
  hp          Int?
  types       String[]
  rarity      String?
  retreatCost String[]

  /// Provider payloads, stored whole. Their shapes are the provider's to
  /// change, and @pokedrop/shared parses them on the way out.
  weaknesses  Json
  resistances Json
  attacks     Json
  abilities   Json
  legalities  Json

  nationalPokedexNumbers Int[]

  imageSmall String
  imageLarge String

  tcgplayerId  String?
  cardmarketId String?

  /// Denormalised so a catalog list does not join the time series. Decimal
  /// rather than Float: these are summed into collection valuations, and
  /// "it is only for display" is how float error ships.
  latestPriceUsd Decimal?  @db.Decimal(10, 2)
  latestPriceEur Decimal?  @db.Decimal(10, 2)
  priceUpdatedAt DateTime?

  updatedAt DateTime @updatedAt

  /// Restrict, not Cascade. A cascade from a set would delete its cards, and
  /// cards cascade into InventoryItem — user property destroyed by deleting a
  /// catalog row. A mirrored set should never be deleted anyway; sync upserts.
  set CardSet @relation(fields: [setId], references: [id], onDelete: Restrict)

  priceSnapshots   PriceSnapshot[]
  inventoryItems   InventoryItem[]
  packOpeningCards PackOpeningCard[]

  @@index([name])
  @@index([setId])
  @@index([rarity])
  /// GIN, because a btree on an array cannot serve a containment query.
  @@index([types], type: Gin)
  @@map("cards")
}

/// The fastest-growing table in the system. docs/DataModel.md caps it at one
/// snapshot per card per day; that needs a unique index on an expression
/// (`capturedAt::date`), which Prisma cannot express — so the cap is enforced
/// by the price sync job, not here.
model PriceSnapshot {
  id         String      @id @default(cuid())
  cardId     String
  source     PriceSource
  currency   String      @db.VarChar(3)
  market     Decimal?    @db.Decimal(10, 2)
  low        Decimal?    @db.Decimal(10, 2)
  mid        Decimal?    @db.Decimal(10, 2)
  high       Decimal?    @db.Decimal(10, 2)
  capturedAt DateTime

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, capturedAt])
  @@map("price_snapshots")
}

// ---------------------------------------------------------------------------
// Economy
//
// The constraints in this section are what actually prevent duplication and
// double-spend; the service code on top of them is the second line, not the
// first. The CHECKs themselves cannot be declared here — Prisma has no syntax
// for them — so they live in a hand-written migration. That is safe: Prisma's
// migration engine models tables, columns, indexes and foreign keys, and has no
// concept of a check constraint, so it neither reports them as drift nor drops
// them. Verified by replaying the whole migration history into an empty
// database, which is what a deployment does.
//
// Deletes: anything a user owns cascades from the user, but nothing cascades
// from the catalog. Deleting a Card must not silently empty someone's
// collection, and deleting a PackTemplate must not erase the history of packs
// opened from it — that is what `active` is for.
// ---------------------------------------------------------------------------

model InventoryItem {
  id             String   @id @default(cuid())
  userId         String
  cardId         String
  quantity       Int
  lockedQuantity Int      @default(0)
  acquiredAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Restrict)

  /// Also serves userId-only lookups as the leading column, so no separate
  /// index on userId.
  @@unique([userId, cardId])
  @@map("inventory_items")
}

model PackTemplate {
  id         String  @id @default(cuid())
  name       String
  setFilter  Json
  cost       Int
  slotConfig Json
  active     Boolean @default(true)

  openings PackOpening[]

  @@map("pack_templates")
}

model PackOpening {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  /// The idempotency guard. A retried open with the same id cannot mint twice.
  openId     String   @unique
  createdAt  DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  template PackTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  cards PackOpeningCard[]

  @@index([userId, createdAt])
  @@map("pack_openings")
}

/// Rarity is stored as pulled rather than read back from Card, so the history
/// stays true even if the catalog later reclassifies the card.
model PackOpeningCard {
  id            String @id @default(cuid())
  packOpeningId String
  cardId        String
  rarity        String

  packOpening PackOpening @relation(fields: [packOpeningId], references: [id], onDelete: Cascade)
  card        Card        @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@index([packOpeningId])
  @@map("pack_opening_cards")
}

/// The ledger behind User.currency. Nothing in the schema keeps the two in
/// agreement — that is the job of the transaction that writes both.
model CurrencyTransaction {
  id        String          @id @default(cuid())
  userId    String
  /// Signed: grants are positive, spends negative.
  amount    Int
  type      TransactionType
  refId     String?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("currency_transactions")
}
