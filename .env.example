# PokeDrop — local development environment.
#
# Copy to .env and adjust only if a port is already taken:
#   cp .env.example .env
#
# These credentials are deliberately weak and well known. They are for local
# containers that bind to localhost only. Never reuse them anywhere else.

# ─── Postgres ────────────────────────────────────────────────────────────────
# Consumed by docker-compose.yml to initialise the cluster.
POSTGRES_USER=pokedrop
POSTGRES_PASSWORD=pokedrop_local_dev
POSTGRES_DB=pokedrop

# Host port for the container, deliberately NOT 5432.
#
# A native PostgreSQL service already owns 5432 on at least one dev machine
# here, and Docker Desktop publishes over it without erroring — so localhost:5432
# silently reaches the wrong server and migrations land in the wrong database.
# 5433 keeps the container unambiguous. The container still listens on 5432
# internally; only the host side moves.
POSTGRES_PORT=5433

# Consumed by Prisma (PD-16) and the API.
#
# NOTE: this duplicates the four values above. Prisma's CLI reads DATABASE_URL
# directly and cannot assemble it from parts in schema.prisma, while Compose
# needs the parts separately to initialise the cluster. If you change the user,
# password, database or port above, change it here too.
#
# No ?schema=public suffix: Prisma defaults to the public schema anyway, and
# leaving it off keeps this URL usable by psql, pgcli and every other libpq
# client, which reject unknown query parameters.
DATABASE_URL=postgresql://pokedrop:pokedrop_local_dev@localhost:5433/pokedrop

# ─── Redis ───────────────────────────────────────────────────────────────────
# Host port. Change this if something already listens on 6379.
REDIS_PORT=6379

REDIS_URL=redis://localhost:6379

# Logical database split. Keeping the cache and the BullMQ queues apart means a
# FLUSHDB against the cache cannot drop queued jobs.
#   0 — read cache (cache-manager, PD-17)
#   1 — BullMQ queues (PD-41)
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development

# The API listens on 4000, not 3000. Next.js claims 3000 by default and
# `pnpm dev` starts both apps at once.
PORT=4000

# Comma-separated allowlist of browser origins. This is the web app.
CORS_ORIGINS=http://localhost:3000

# ─── Auth ────────────────────────────────────────────────────────────────────
# Optional until Better Auth lands in PD-29, then required. Minimum 32
# characters. Generate with: openssl rand -base64 48
# AUTH_SECRET=

# ─── External providers ──────────────────────────────────────────────────────
# Optional permanently. pokemontcg.io serves unauthenticated callers at a lower
# rate limit, so the app boots fine without a key. Get one at
# https://dev.pokemontcg.io to raise the ceiling.
# POKEMONTCG_API_KEY=

POKEMONTCG_BASE_URL=https://api.pokemontcg.io/v2
TCGDEX_BASE_URL=https://api.tcgdex.net/v2

# ─── Queue ───────────────────────────────────────────────────────────────────
# BullMQ worker concurrency (PD-41).
QUEUE_CONCURRENCY=4
