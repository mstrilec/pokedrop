# PokeDrop — local development environment.
#
# Copy to .env and adjust only if a port is already taken:
#   cp .env.example .env
#
# These credentials are deliberately weak and well known. They are for local
# containers that bind to localhost only. Never reuse them anywhere else.

# ─── Postgres ────────────────────────────────────────────────────────────────
# Consumed by docker-compose.yml to initialise the cluster.
POSTGRES_USER=pokedrop
POSTGRES_PASSWORD=pokedrop_local_dev
POSTGRES_DB=pokedrop

# Host port for the container, deliberately NOT 5432.
#
# A native PostgreSQL service already owns 5432 on at least one dev machine
# here, and Docker Desktop publishes over it without erroring — so localhost:5432
# silently reaches the wrong server and migrations land in the wrong database.
# 5433 keeps the container unambiguous. The container still listens on 5432
# internally; only the host side moves.
POSTGRES_PORT=5433

# Consumed by Prisma (PD-16) and the API.
#
# NOTE: this duplicates the four values above. Prisma's CLI reads DATABASE_URL
# directly and cannot assemble it from parts in schema.prisma, while Compose
# needs the parts separately to initialise the cluster. If you change the user,
# password, database or port above, change it here too.
#
# No ?schema=public suffix: Prisma defaults to the public schema anyway, and
# leaving it off keeps this URL usable by psql, pgcli and every other libpq
# client, which reject unknown query parameters.
DATABASE_URL=postgresql://pokedrop:pokedrop_local_dev@localhost:5433/pokedrop

# Logs every SQL statement Prisma issues. Off by default: useful when hunting
# N+1 queries, noise the rest of the time.
DB_QUERY_LOGGING=false

# ─── Redis ───────────────────────────────────────────────────────────────────
# Host port. Change this if something already listens on 6379.
REDIS_PORT=6379

REDIS_URL=redis://localhost:6379

# Logical database split. Keeping the cache and the BullMQ queues apart means a
# FLUSHDB against the cache cannot drop queued jobs.
#   0 — read cache (cache-manager, PD-17)
#   1 — BullMQ queues (PD-41)
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# The API listens on 4000, not 3000. Next.js claims 3000 by default and
# `pnpm dev` starts both apps at once.
PORT=4000

# Comma-separated allowlist of browser origins. This is the web app.
CORS_ORIGINS=http://localhost:3000

# ─── Auth ────────────────────────────────────────────────────────────────────
# Required. Signs session cookies and verification tokens, so rotating it signs
# everyone out. Minimum 32 characters; generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output
AUTH_BASE_URL=http://localhost:4000

# Unset means a host-only cookie, which is what you want in development and in
# any deployment where the web app and the API share a host. Set it to a parent
# domain (".pokedrop.app") only to share the session across subdomains.
# AUTH_COOKIE_DOMAIN=

# lax | strict | none. `none` is for a deployment where the web app and the API
# are on different registrable domains, and it requires AUTH_SECURE_COOKIES=true
# — the app refuses to boot otherwise, because browsers drop such a cookie
# without saying so.
AUTH_COOKIE_SAME_SITE=lax

# Unset means "on in production". Controls both the Secure attribute and the
# __Secure- cookie name prefix. Turn it on in staging only if it serves https.
# AUTH_SECURE_COOKIES=true

# ─── External providers ──────────────────────────────────────────────────────
# Optional permanently. pokemontcg.io serves unauthenticated callers at a lower
# rate limit, so the app boots fine without a key. Get one at
# https://dev.pokemontcg.io to raise the ceiling.
# POKEMONTCG_API_KEY=

POKEMONTCG_BASE_URL=https://api.pokemontcg.io/v2
TCGDEX_BASE_URL=https://api.tcgdex.net/v2

# ─── Queue ───────────────────────────────────────────────────────────────────
# BullMQ worker concurrency (PD-41).
QUEUE_CONCURRENCY=4

# ─── Rate limiting ───────────────────────────────────────────────────────────
# How many proxies sit in front of the API. 0 for direct exposure and local
# development; 1 behind a single load balancer. Never set this to a value
# higher than the real hop count: the extra hops are read from a header the
# client controls, which lets it choose its own rate-limit key.
TRUST_PROXY_HOPS=0

# Every route that is not a health probe. Windows are in SECONDS.
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_DEFAULT_WINDOW=60

# Sign-in, sign-up and the password reset routes. This is the control that
# blunts account enumeration: one duplicate registration reveals one address,
# and this is what stops someone walking a list of a million.
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_WINDOW=900

# Pack opening and trade creation, applied when those routes exist.
THROTTLE_MODERATE_LIMIT=30
THROTTLE_MODERATE_WINDOW=60
