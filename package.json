{
  "name": "pokedrop",
  "version": "0.0.0",
  "private": true,
  "description": "Pokemon TCG web application - open packs, collect, build decks, trade",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.11.0 <23",
    "pnpm": ">=10.17.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @pokedrop/shared build",
    "typecheck": "pnpm build:shared && pnpm -r run typecheck",
    "lint": "pnpm build:shared && eslint .",
    "lint:fix": "pnpm build:shared && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "pnpm --filter @pokedrop/api db:seed",
    "clean": "pnpm -r run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,jsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
